{
  "manifest_version": 3,
  "name": "Overleaf AI (Claude / Codex CLI)",
  "short_name": "Overleaf AI",
  "version": "0.2.0",
  "description": "Overleaf 에서만 동작하는 AI 글쓰기 도우미. 로컬 Claude Code CLI 또는 OpenAI Codex CLI 로 글을 작성·수정합니다.",
  "key": "",
  "permissions": ["nativeMessaging", "storage"],
  "host_permissions": ["https://www.overleaf.com/*", "https://overleaf.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.overleaf.com/project/*", "https://overleaf.com/project/*"],
      "js": ["content/main-world.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.overleaf.com/project/*", "https://overleaf.com/project/*"],
      "js": ["content/catalog.js", "content/prompts.js", "content/diff.js", "content/lint.js", "content/markdown.js", "content/panel-css.js", "content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-panel": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "AI 패널 열기/닫기"
    },
    "quick-action": {
      "suggested_key": { "default": "Alt+Shift+I" },
      "description": "빠른 실행: 선택 영역 다듬기 / '% ai:' 지시문 실행"
    }
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Overleaf AI",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
